# ==============================================================================
# EpicLens System - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with real credentials to GitHub.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo

# Database Connection (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epiclens_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=false
